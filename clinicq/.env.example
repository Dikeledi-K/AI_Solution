# Copy this file to .env and fill in what you need.  NEVER commit .env to git.

# ---- AI provider: mock (default, offline) | anthropic | gemini | groq ----
LLM_PROVIDER=mock

# Claude (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Google Gemini – free tier (LLM_PROVIDER=gemini, then: pip install google-genai)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq – free tier (LLM_PROVIDER=groq, then: pip install groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- SMS: mock (default, logs only) | clickatell (stub, not implemented yet) ----
SMS_PROVIDER=mock
CLICKATELL_API_KEY=

# ---- Mode ----
# 1 = classroom demo: demo staff accounts with PUBLIC PINs, demo patients, "Simulate AI failure"
#     and "Reset demo patients". NEVER use demo mode for a real clinic.
CLINICQ_DEMO_MODE=0
# Real (non-demo) installs: one-time code needed to create the first administrator.
# Choose a long random value, create the admin, then you may remove it.
CLINICQ_SETUP_CODE=

# ---- Encrypted backups (python -m core.backup) ----
# Create a key with:  python -m core.backup new-key   – keep a copy somewhere safe, away from the backups.
CLINICQ_BACKUP_KEY=
# CLINICQ_BACKUP_DIR=backups
# CLINICQ_BACKUP_KEEP=30

# ---- Staff sign-in ----
# Staff sign in with their own staff ID + PIN (managed on the Staff page).
# Minutes without activity before a staff member is signed out automatically.
CLINICQ_SESSION_MINUTES=30

# ---- Storage (optional overrides) ----
# CLINICQ_CONTACTS_PATH=data/contacts.json
# CLINICQ_DB_PATH=data/clinicq.db
# SMS_OUTBOX_PATH=data/sms_outbox.log
